<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DynoTune.Views.TuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tuning" Style="{StaticResource TitleTextBlockStyle}"/>

        <Border Grid.Row="1" Padding="10" CornerRadius="8"
                Background="#A0227A00"
                BorderBrush="#FF2D7D2A" BorderThickness="1">
            <TextBlock Text="{Binding OptimizationBannerText}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="2" Padding="6,4" CornerRadius="6"
                Background="#15004A7A"
                BorderBrush="#220078D4" BorderThickness="1"
                Visibility="{Binding SearchBadgeVisibility}">
            <TextBlock Text="{Binding SearchBadgeText}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="3" Padding="12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Windows Power Plan" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding PowerPlanOptions}"
                          SelectedItem="{Binding SelectedPowerPlan, Mode=TwoWay}"/>
                <Button x:ConnectionId='26' Grid.Column="2" Content="Apply Plan"                              />
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Profile" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProfileNames}"
                          SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"/>
                <Button x:ConnectionId='25' Grid.Column="2" Content="Apply Profile"                                 />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <Button x:ConnectionId='19' Content="Start Optimization"
                                                         
                    IsEnabled="{Binding CanStartOptimization}"/>
            <Button x:ConnectionId='20' Content="Stop Optimization"
                                                        
                    IsEnabled="{Binding CanStopOptimization}"/>
            <Button x:ConnectionId='21' Content="Apply Recommended"                                     />
            <Button x:ConnectionId='22' Content="Rollback to Vendor Safe"                                   />
            <Button x:ConnectionId='23' Content="Search (Manual)"                                       />
            <Button x:ConnectionId='24' Content="Stop Search"                                      />
        </StackPanel>

        <Border Grid.Row="6" Padding="12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="Enable auto-apply"
                          IsChecked="{Binding AutoApplyEnabled, Mode=TwoWay}"/>
                <NumberBox Grid.Column="1" Width="120"
                           Header="After N accepted"
                           Value="{Binding AutoApplyAfterAcceptedCount, Mode=TwoWay}"/>
                <Button x:ConnectionId='18' Grid.Column="2" VerticalAlignment="Bottom" Content="Refresh"                            />
            </Grid>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
            <Button x:ConnectionId='16' Content="Force Safe Rollback"                              />
            <Button x:ConnectionId='17' Content="Clear Danger State"                                />
        </StackPanel>

        <Border Grid.Row="8" Padding="12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBlock Text="Trial Parameters (Baseline vs Current)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Windows Power Plan Baseline:"/><TextBlock Text="{Binding TrialBaselinePowerPlan}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Windows Power Plan Current:"/><TextBlock Text="{Binding TrialCurrentPowerPlan}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Voltage Baseline:"/><TextBlock Text="{Binding TrialBaselineGpuVoltage}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Voltage Current:"/><TextBlock Text="{Binding TrialCurrentGpuVoltage}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Core Clock Baseline:"/><TextBlock Text="{Binding TrialBaselineGpuClock}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Core Clock Current:"/><TextBlock Text="{Binding TrialCurrentGpuClock}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Power Limit Baseline:"/><TextBlock Text="{Binding TrialBaselineGpuPowerLimit}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="GPU Power Limit Current:"/><TextBlock Text="{Binding TrialCurrentGpuPowerLimit}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Perf Drop vs Baseline:"/><TextBlock Text="{Binding TrialPerfDrop}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Power Delta vs Baseline:"/><TextBlock Text="{Binding TrialPowerDelta}"/></StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="9" Padding="12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <TextBlock Text="Live Safety State" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:ConnectionId='2' x:Name="OptimizerPhaseText" Text="Optimizer Phase: --"/>
                <TextBlock x:ConnectionId='3' x:Name="OptimizerRunStatusText" Text="Optimization Status: --"/>
                <TextBlock x:ConnectionId='4' x:Name="OptimizerBaselineText" Text="Baseline: --"/>
                <TextBlock x:ConnectionId='5' x:Name="OptimizerRecommendationText" Text="Recommendation: --" TextWrapping="Wrap"/>
                <TextBlock x:ConnectionId='6' x:Name="OptimizerDecisionText" Text="Last Decision: --" TextWrapping="Wrap"/>
                <TextBlock x:ConnectionId='7' x:Name="SearchPhaseText" Text="Search Phase: --"/>
                <TextBlock x:ConnectionId='8' x:Name="SearchWorkloadText" Text="Search Workload: --"/>
                <TextBlock x:ConnectionId='9' x:Name="SearchCandidateText" Text="Search Candidate: --"/>
                <TextBlock x:ConnectionId='10' x:Name="SearchBestText" Text="Search Best: --"/>
                <TextBlock x:ConnectionId='11' x:Name="SearchDecisionText" Text="Search Decision: --" TextWrapping="Wrap"/>
                <TextBlock x:ConnectionId='12' x:Name="DangerLevelText" Text="Danger: --"/>
                <TextBlock x:ConnectionId='13' x:Name="DangerReasonText" Text="Reason: --"/>
                <TextBlock x:ConnectionId='14' x:Name="DangerDetailText" Text="Detail: --" TextWrapping="Wrap"/>
                <TextBlock x:ConnectionId='15' x:Name="DangerRollbackText" Text="Rollback Applied: --"/>
                <TextBlock Text="{Binding StatusText}" Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

